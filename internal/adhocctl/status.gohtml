<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Sprawl Status</title>
        <style>
            :root {
                --bg-body: #101014;
                --bg-card: #1b1b20;
                --bg-card-hover: #22222a;
                --bg-elevated: #26262e;
                --bg-overlay-backdrop: rgba(5, 5, 8, 0.88);
                --bg-overlay-content: #1c1c22;
                --border: #303038;
                --border-light: #3a3a44;
                --text-primary: #f2f2f5;
                --text-secondary: #a8a8b3;
                --text-muted: #7a7a85;
                --accent: #4da8ff;
                --accent-dark: #2f8ae0;
                --accent-soft: rgba(77, 168, 255, 0.15);
                --radius-sm: 6px;
                --radius-md: 10px;
                --shadow-card: 0 2px 8px rgba(0, 0, 0, 0.35);
                --shadow-overlay: 0 20px 50px rgba(0, 0, 0, 0.6);
            }

            * {
                box-sizing: border-box;
            }

            body {
                background-color: var(--bg-body);
                color: var(--text-primary);
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                margin: 0;
                padding: 24px;
            }

            h1 {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 12px;
                color: var(--text-primary);
                font-size: 1.6rem;
                margin: 0 0 6px;
            }

            .summary {
                margin-bottom: 24px;
                color: var(--text-secondary);
            }

            .title-list-container {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(480px, 600px));
                justify-content: center;
                gap: 16px;
            }

            .title-card {
                display: flex;
                border-radius: var(--radius-md);
                box-shadow: var(--shadow-card);
                cursor: pointer;
                height: 100%;
                max-width: 600px;
            }

            .title-card-inner {
                display: flex;
                flex-direction: column;
                flex: 1;
                background-color: var(--bg-card);
                border: 1px solid var(--border);
                border-radius: var(--radius-md);
                overflow: hidden;
                transition: background-color 0.2s, border-color 0.2s, transform 0.15s;
            }

            .title-card:hover .title-card-inner {
                background-color: var(--bg-card-hover);
                border-color: var(--border-light);
                transform: translateY(-2px);
            }

            .title-header {
                display: flex;
                flex: 1;
                gap: 15px;
                align-items: flex-start;
                padding: 15px;
            }

            .title-image {
                width: 144px;
                height: 80px;
                background-color: var(--bg-elevated);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                color: var(--text-muted);
                font-size: 12px;
                border: 1px solid var(--border-light);
                border-radius: var(--radius-sm);
                background-size: cover;
                background-position: center;
            }

            .title-info {
                flex-grow: 1;
                min-width: 0;
            }

            .title-name {
                font-size: 1.15rem;
                font-weight: 600;
                color: var(--text-primary);
                margin: 0;
                overflow-wrap: anywhere;
                word-break: break-word;
                line-height: 1.3;
            }

            .title-meta {
                font-size: 0.85rem;
                color: var(--text-secondary);
                margin-top: 6px;
                overflow-wrap: anywhere;
                word-break: break-word;
            }

            .title-card.open .groups-overlay {
                display: flex;
            }

            .groups-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: var(--bg-overlay-backdrop);
                z-index: 1000;
                display: none;
                justify-content: center;
                align-items: center;
                cursor: default;
                padding: 20px;
            }

            .overlay-content {
                background-color: var(--bg-overlay-content);
                border: 1px solid var(--border);
                border-radius: var(--radius-md);
                width: 90%;
                max-width: 900px;
                max-height: 90vh;
                overflow-y: auto;
                position: relative;
                padding: 24px;
                box-shadow: var(--shadow-overlay);
            }

            .close-button {
                position: absolute;
                top: 14px;
                right: 18px;
                font-size: 26px;
                color: var(--text-secondary);
                cursor: pointer;
                transition: color 0.2s;
                line-height: 1;
            }

            .close-button:hover {
                color: var(--text-primary);
            }

            .overlay-title {
                margin: 0;
                padding-right: 30px;
                padding-bottom: 12px;
                border-bottom: 1px solid var(--border);
                overflow-wrap: anywhere;
                word-break: break-word;
            }

            .overlay-meta {
                margin: 10px 0 20px;
                color: var(--text-secondary);
            }

            .groups-list-title {
                margin: 0 0 12px;
                color: var(--text-secondary);
                font-size: 0.95rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.03em;
            }

            .groups-list {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
                gap: 12px;
            }

            .group-item {
                display: flex;
                flex-direction: column;
                background-color: var(--bg-elevated);
                border-radius: var(--radius-sm);
                border-left: 3px solid var(--accent);
                padding: 12px;
            }

            .group-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 10px;
            }

            .group-id {
                font-weight: 600;
                font-size: 0.9rem;
                color: var(--accent);
            }

            .group-uptime {
                font-size: 0.8rem;
                color: var(--text-muted);
                font-family: 'Consolas', 'Courier New', monospace;
            }

            .player-list {
                list-style: none;
                margin: 0;
                padding: 0;
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
                gap: 6px;
            }

            .player-list li {
                background-color: var(--bg-card);
                border: 1px solid var(--border);
                border-radius: var(--radius-sm);
                padding: 6px 10px;
                font-size: 0.85rem;
                color: var(--text-secondary);
                text-align: center;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .total-players-badge {
                background-color: var(--accent-soft);
                color: var(--accent);
                border: 1px solid var(--accent-dark);
                padding: 3px 10px;
                border-radius: 999px;
                font-size: 0.85rem;
                font-weight: 600;
            }
        </style>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                document.querySelectorAll('.title-card').forEach(card => {
                    card.addEventListener('click', () => {
                        card.classList.add('open');
                    });
                });

                document.querySelectorAll('.groups-overlay').forEach(overlay => {
                    overlay.addEventListener('click', (event) => {
                        event.stopPropagation();
                        overlay.parentElement.classList.remove('open');
                    });
                });

                document.querySelectorAll('.overlay-content').forEach(content => {
                    content.addEventListener('click', (event) => {
                        event.stopPropagation();
                    });
                });

                document.querySelectorAll('.close-button').forEach(btn => {
                    btn.addEventListener('click', (event) => {
                        event.stopPropagation();
                        btn.closest('.title-card').classList.remove('open');
                    });
                });

                function updateUptimes() {
                    const now = Math.floor(Date.now() / 1000);
                    document.querySelectorAll('.group-item').forEach(item => {
                        const createdAt = parseInt(item.dataset.createdAt);
                        if (isNaN(createdAt)) return;

                        const delta = now - createdAt;
                        const element = item.querySelector('.group-uptime');
                        if (!element) return;

                        if (delta < 0) return;

                        const hours = String(Math.floor(delta / 3600)).padStart(2, '0');
                        const minutes = String(Math.floor((delta % 3600) / 60)).padStart(2, '0');
                        const seconds = String(delta % 60).padStart(2, '0');

                        element.textContent = `${hours}:${minutes}:${seconds}`;
                    });
                }

                updateUptimes();
                setInterval(updateUptimes, 1000);
            });
        </script>
    </head>
    <body>
        <h1>Sprawl Status Page <span class="total-players-badge">{{.TotalPlayers}} Players Online</span></h1>
        <div class="summary">
            Displaying {{len .Titles}} active titles
        </div>

        <div class="title-list-container">
            {{range .Titles}}
                <div class="title-card">
                    <div class="title-card-inner">
                        <div class="title-header">
                            <div class="title-image"
                                 style="background-image: url('https://static.sprawl-relay.link/titledb/{{.TitleID}}.png'), url('https://static.sprawl-relay.link/titledb/placeholder.jpg');"></div>
                            <div class="title-info">
                                <p class="title-name">{{if .Name}}{{.Name}}{{else}}Unknown Title{{end}}</p>
                                <p class="title-meta">{{.TitleID}} | {{.PlayerCount}} Players</p>
                            </div>
                        </div>
                    </div>
                    <div class="groups-overlay">
                        <div class="overlay-content">
                            <span class="close-button">&times;</span>
                            <h2 class="overlay-title">{{if .Name}}{{.Name}}{{else}}Unknown Title{{end}}</h2>
                            <p class="title-meta overlay-meta">{{.TitleID}} | {{.PlayerCount}}
                                Players</p>

                            <h4 class="groups-list-title">Active Groups ({{len .Groups}})</h4>
                            <div class="groups-list">
                                {{range .Groups}}
                                    <div class="group-item" data-created-at="{{.CreatedAt}}">
                                        <div class="group-header">
                                            <div class="group-id">Group {{.ID}}</div>
                                            <div class="group-uptime"></div>
                                        </div>
                                        <ul class="player-list">
                                            {{range .Players}}
                                                <li>{{.}}</li>
                                            {{end}}
                                        </ul>
                                    </div>
                                {{end}}
                            </div>
                        </div>
                    </div>
                </div>
            {{end}}
        </div>
    </body>
</html>
