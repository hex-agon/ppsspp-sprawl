<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sprawl Debug</title>
    <style>
        :root {
            --bg-body: #101014;
            --bg-card: #1b1b20;
            --bg-card-hover: #22222a;
            --bg-elevated: #26262e;
            --bg-overlay-backdrop: rgba(5, 5, 8, 0.88);
            --bg-overlay-content: #1c1c22;
            --border: #303038;
            --border-light: #3a3a44;
            --text-primary: #f2f2f5;
            --text-secondary: #a8a8b3;
            --text-muted: #7a7a85;
            --accent: #4da8ff;
            --accent-dark: #2f8ae0;
            --accent-soft: rgba(77, 168, 255, 0.15);
            --radius-sm: 6px;
            --radius-md: 10px;
            --shadow-card: 0 2px 8px rgba(0, 0, 0, 0.35);
            --shadow-overlay: 0 20px 50px rgba(0, 0, 0, 0.6);
        }

        * {
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg-body);
            color: var(--text-primary);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 24px;
        }

        h1, h2, h3 {
            color: var(--text-primary);
        }

        h1 {
            font-size: 1.6rem;
            margin: 0 0 24px;
        }

        .tabs {
            display: flex;
            gap: 4px;
            border-bottom: 1px solid var(--border);
        }

        .tab {
            padding: 10px 20px;
            cursor: pointer;
            border: 1px solid transparent;
            border-bottom: none;
            border-radius: var(--radius-sm) var(--radius-sm) 0 0;
            color: var(--text-secondary);
            transition: background-color 0.2s, color 0.2s;
        }

        .tab:hover {
            background-color: var(--bg-card-hover);
            color: var(--text-primary);
        }

        .tab.active {
            border-color: var(--border);
            background: var(--bg-card);
            font-weight: 600;
            color: var(--accent);
        }

        .tab-content {
            display: none;
            padding: 20px;
            border: 1px solid var(--border);
            border-top: none;
            border-radius: 0 0 var(--radius-md) var(--radius-md);
            background: var(--bg-card);
            box-shadow: var(--shadow-card);
        }

        .tab-content.active {
            display: block;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            border: 1px solid var(--border);
            padding: 8px;
            text-align: left;
        }

        th {
            background-color: var(--bg-elevated);
            color: var(--text-primary);
        }

        td {
            color: var(--text-secondary);
        }

        tr:nth-child(even) {
            background-color: var(--bg-card-hover);
        }
    </style>
</head>
<body>
    <h1>Sprawl Debug</h1>
    <div class="tabs">
        <div class="tab active" onclick="showTab('ctl')">Ctl Server Clients</div>
        <div class="tab" onclick="showTab('exchange')">Exchange Clients</div>
        <div class="tab" onclick="showTab('peerhub')">PeerHub Peers</div>
    </div>

    <div id="ctl" class="tab-content active">
        <h2>Ctl Server Clients</h2>
        <table>
            <thead>
                <tr>
                    <th>MAC</th>
                    <th>Name</th>
                    <th>IP</th>
                    <th>Title ID</th>
                    <th>Group ID</th>
                    <th>Leader</th>
                </tr>
            </thead>
            <tbody>
                {{range .CtlClients}}
                <tr>
                    <td>{{.MAC}}</td>
                    <td>{{.Name}}</td>
                    <td>{{.IP}}</td>
                    <td>{{.TitleID}}</td>
                    <td>{{.GroupID}}</td>
                    <td>{{if .IsLeader}}Yes{{else}}No{{end}}</td>
                </tr>
                {{else}}
                <tr><td colspan="6">No clients connected</td></tr>
                {{end}}
            </tbody>
        </table>
    </div>

    <div id="exchange" class="tab-content">
        <h2>Exchange Clients</h2>
        <table>
            <thead>
                <tr>
                    <th>MAC</th>
                    <th>Port</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                {{range .ExchangeClients}}
                <tr>
                    <td>{{.MAC}}</td>
                    <td>{{.Port}}</td>
                    <td>{{.IP}}</td>
                </tr>
                {{else}}
                <tr><td colspan="3">No clients connected</td></tr>
                {{end}}
            </tbody>
        </table>
    </div>

    <div id="peerhub" class="tab-content">
        <h2>PeerHub Peers</h2>
        <h3>Listening Peers</h3>
        <table>
            <thead>
                <tr>
                    <th>MAC</th>
                    <th>Port</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                {{range .ListeningPeers}}
                <tr>
                    <td>{{.MAC}}</td>
                    <td>{{.Port}}</td>
                    <td>{{.IP}}</td>
                </tr>
                {{else}}
                <tr><td colspan="3">No listening peers</td></tr>
                {{end}}
            </tbody>
        </table>

        <h3>Connected Peers</h3>
        <table>
            <thead>
                <tr>
                    <th>MAC</th>
                    <th>Port</th>
                    <th>IP</th>
                    <th>Connected To</th>
                </tr>
            </thead>
            <tbody>
                {{range .ConnectedPeers}}
                <tr>
                    <td>{{.MAC}}</td>
                    <td>{{.Port}}</td>
                    <td>{{.IP}}</td>
                    <td>{{if .ConnectedTo}}{{.ConnectedTo}}{{else}}-{{end}}</td>
                </tr>
                {{else}}
                <tr><td colspan="4">No connected peers</td></tr>
                {{end}}
            </tbody>
        </table>
    </div>

    <script>
        function showTab(id) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            event.currentTarget.classList.add('active');
        }
    </script>
</body>
</html>
